{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": [
        "app.py",
        "config.py",
        "models.py",
        "extensions.py",
        "accounting/**",
        "imports/**",
        "exports/**",
        "templates/**",
        "static/**",
        "accounting_pro.db"
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
